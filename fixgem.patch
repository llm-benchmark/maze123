+/* Player progress belongs to the icon, never to the whole thumbnail. */
+.world-map-gem {
+  position: absolute;
+  top: 2px;
+  left: 2px;
+  width: clamp(15px, calc(var(--world-map-tile-size, 82px) * .34), 32px);
+  color: #17616a;
+  pointer-events: none;
+  z-index: 2;
+}
+.world-map-gem svg { display: block; width: 100%; height: auto; }
+.world-map-gem.is-collected {
+  color: #fff;
+  filter: drop-shadow(0 0 3px rgba(190, 255, 255, .85));
+}
+.world-map-gem-count {
+  display: block;
+  background: #000;
+  color: currentColor;
+  font: bold 9px/12px sans-serif;
+  text-align: center;
+}
+.world-map-cell.locked,
+.world-map-cell.locked:is(:hover, :focus-visible, :active) {
+  background: #000;
+  opacity: 1;
+  filter: none;
+  box-shadow: none;
+  outline: none;
+  pointer-events: none;
+}
+.world-map-cell.locked > * { visibility: hidden; }
+.world-map-cell.locked::after { display: none; }
