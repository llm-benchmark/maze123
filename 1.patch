+  // ----- 存档 ID 输入框（新增）-----
+  (function initSaveIdBar() {
+    const bar = document.createElement("div");
+    bar.className = "save-id-bar";
+    bar.innerHTML =
+      '<label class="save-id-label">存档 ID</label>' +
+      '<input type="text" id="save-id-input" class="save-id-input" placeholder="输入存档 ID，例如 player1" autocomplete="off" spellcheck="false">' +
+      '<button id="save-id-set" class="save-id-set-button" type="button">设置</button>' +
+      '<span id="save-id-status" class="save-id-status"></span>';
+
+    const pageHead = document.querySelector(".page-head");
+    if (pageHead) {
+      pageHead.parentNode.insertBefore(bar, pageHead.nextSibling);
+    }
+
+    const input = document.getElementById("save-id-input");
+    const setBtn = document.getElementById("save-id-set");
+    const statusEl = document.getElementById("save-id-status");
+
+    function setStatus(msg, isError) {
+      if (!statusEl) return;
+      statusEl.textContent = msg || "";
+      statusEl.classList.toggle("is-error", Boolean(isError));
+    }
+
+    function loadCurrentSaveId() {
+      return window.localStorage && window.localStorage.getItem("mazebench-save-id");
+    }
+
+    function saveCurrentSaveId(id) {
+      if (window.localStorage) {
+        if (id) window.localStorage.setItem("mazebench-save-id", id);
+        else window.localStorage.removeItem("mazebench-save-id");
+      }
+    }
+
+    // 真实的 PLAY 入口是各卡片里的 <a href="/play/...">（不是 .world-card__link，
+    // 那是编辑链接）。卡片是 innerHTML 重建的，所以每次变动都要重新贴一遍。
+    // 用 URL/searchParams.set 保证幂等，不会把 ?save_id= 叠很多次。
+    function refreshPlayLinksWithSaveId(saveId) {
+      const links = document.querySelectorAll('a[href^="/play/"]');
+      for (let i = 0; i < links.length; i += 1) {
+        const href = links[i].getAttribute("href") || "";
+        if (!href.startsWith("/play/")) continue;
+        try {
+          const url = new URL(href, window.location.origin);
+          if (saveId) url.searchParams.set("save_id", saveId);
+          links[i].setAttribute("href", url.pathname + url.search);
+        } catch (error) {
+          /* 保留原链接 */
+        }
+      }
+    }
+
+    if (input) input.value = loadCurrentSaveId() || "";
+    refreshPlayLinksWithSaveId(loadCurrentSaveId());
+
+    // 卡片重渲染后自动补一次（防抖到下一帧）。
+    let refreshPending = false;
+    const observer = new MutationObserver(() => {
+      if (refreshPending) return;
+      refreshPending = true;
+      window.requestAnimationFrame(() => {
+        refreshPending = false;
+        refreshPlayLinksWithSaveId(loadCurrentSaveId());
+      });
+    });
+    observer.observe(document.body, { childList: true, subtree: true });
+
+    function handleSet() {
+      const id = (input && input.value || "").trim();
+      if (!id) {
+        setStatus("请输入一个存档 ID", true);
+        return;
+      }
+      if (!/^[A-Za-z0-9_-]{1,64}$/.test(id)) {
+        setStatus("存档 ID 只能用字母、数字、下划线、连字符（1-64 位）", true);
+        return;
+      }
+      saveCurrentSaveId(id);
+      setStatus('存档 ID 已设置为 "' + id + '"，点击 PLAY 后游戏会自动加载这个存档。');
+      refreshPlayLinksWithSaveId(id);
+    }
+
+    if (setBtn) setBtn.addEventListener("click", handleSet);
+    if (input) {
+      input.addEventListener("keydown", function (e) {
+        if (e.key === "Enter") handleSet();
+      });
+    }
+  })();
+
   renderWorlds();
 })();
